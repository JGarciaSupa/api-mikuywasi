DATABASE_URL=postgres://root:root@localhost:5432/db_restaurante
PORT=3000

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=nombre-de-tu-bucket
R2_PUBLIC_URL=https://tu-dominio-publico.r2.dev

# Auth
JWT_SECRET=tu_jwt_secret_aqui

# Redis Configuration
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Facturador electronico SUNAT
FACTURADOR_URL=http://facturador-restaurante:8080

# Entorno: "production" en QAS y PRD (cookies seguras con HTTPS)
NODE_ENV=production

# Consulta de RUC/DNI (Facturacion-API)
RUC_API_URL=https://facturacion-api.example.com

# Opcional: host que reemplaza al de db_servers al conectar a las BDs de tenants
# DB_HOST_OVERRIDE=

# Migraciones de tenants al arrancar el contenedor (docker/start.sh)
# RUN_MIGRATIONS_ON_START=true
# RUN_RBAC_SYNC_ON_START=true
# RUN_DEPLOY_TASKS_ON_START=true
# Aviso si falla un despliegue (Slack, Discord, Google Chat: URL del webhook entrante)
# DEPLOY_ALERT_WEBHOOK_URL=
# DEPLOY_ALERT_ON_SUCCESS=false
# DEPLOY_ENV_NAME=QAS
# MIGRATIONS_STRICT=false

# Solo QAS: actualizar/clonar tenants desde PRD (Super Admin → Sincronizar desde PRD).
# Usuario de SOLO LECTURA en el servidor de PRD (GRANT pg_read_all_data). Nunca en PRD.
# PRD_SYNC_ENABLED=true
# PRD_SYNC_DB_HOST=
# PRD_SYNC_DB_PORT=5432
# PRD_SYNC_DB_USER=qas_sync_reader
# PRD_SYNC_DB_PASSWORD=
# PRD_SYNC_MASTER_DB=db_master
